{
  "easy": {
    "name": "Syntax Worm",
    "phases": [
      {
        "phase": 1,
        "sprite": "boss-easy-1.png",
        "dialogue": {
          "start": [
            "Ты не сможешь найти все мои ошибки!",
            "Этот код обречён, как и ты!",
            "Ха! Ты даже точку с запятой не найдёшь!"
          ],
          "onDamage": [
            "Ай! Ладно, это было легко...",
            "Ты... нашёл это? Неплохо.",
            "Больнее, чем я думал..."
          ],
          "onPhaseChange": [
            "Ты злишь меня!",
            "Хватит! Теперь я серьёзно!",
            "Ты пожалеешь, что зашёл так далеко!"
          ],
          "onDefeat": [
            "Нет! Мой код... он... компилируется...",
            "Ладно... ты победил... в этот раз...",
            "Я... вернусь... с новыми ошибками..."
          ],
          "onPlayerError": [
            "Ха! Твои действия только добавляют багов!",
            "Синтаксис всё ещё сломан! Ты промазал!"
          ],
          "onPlayerDefeat": [
            "Syntax Error! Твой код даже не запустился!",
            "Компилятор отклонил твою попытку. Проигрыш!"
          ]
        }
      },
      {
        "phase": 2,
        "sprite": "boss-easy-2.png",
        "dialogue": {
          "start": [
            "Теперь я серьёзно!",
            "Ты не пройдёшь дальше!",
            "Моя вторая форма... узри!"
          ],
          "onDamage": [
            "Больнее, чем я думал...",
            "Ты сильнее, чем кажешься...",
            "Это... не может быть..."
          ],
          "onDefeat": [
            "Ладно, ты победил...",
            "Мой код... он идеален... как же так...",
            "Я... ещё... вернусь..."
          ],
          "onPlayerError": [
            "Во второй форме мои ошибки тебе не под силу!",
            "Мимо! Твой вариант ответа ломает всё ещё сильнее!",
            "Даже не близко! Забудь про правильный синтаксис!"
          ],
          "onPlayerDefeat": [
            "Вторая фаза оказалась для тебя непреодолима!",
            "Конец сессии! Твой код отправлен в корзину!"
          ]
        }
      }
    ]
  },
  "medium": {
    "name": "Logic Wraith",
    "phases": [
      {
        "phase": 1,
        "sprite": "boss-medium-1.png",
        "dialogue": {
          "start": [
            "Твоя логика ничего не стоит против моей!",
            "Я искажаю саму суть кода!",
            "Ты не найдёшь ошибку в моей логике!"
          ],
          "onDamage": [
            "Как ты... это заметил?",
            "Моя логика... безупречна...",
            "Ты умнее, чем я думал..."
          ],
          "onPhaseChange": [
            "Ты разрушил мою логику!",
            "Теперь я покажу истинную силу!",
            "Ты пожалеешь об этом!"
          ],
          "onDefeat": [
            "Моя логика... рушится...",
            "Ты... победил... меня...",
            "Я... исчезаю... во тьме..."
          ],
          "onPlayerError": [
            "Ха-ха! Твоё условие дало ложный результат!",
            "Твоя логика дала сбой. Минус HP!"
          ],
          "onPlayerDefeat": [
            "Логическая ошибка! Твой алгоритм зашёл в тупик.",
            "Ты попался в мою логическую ловушку! Game Over.",
            "Твоё мышление слишком предсказуемо!"
          ]
        }
      },
      {
        "phase": 2,
        "sprite": "boss-medium-2.png",
        "dialogue": {
          "start": [
            "Теперь моя логика идеальна!",
            "Ты не сможешь меня победить!",
            "Узри мою истинную форму!"
          ],
          "onDamage": [
            "Невозможно... моя логика...",
            "Ты... снова... нашёл...",
            "Это... не... логично..."
          ],
          "onDefeat": [
            "Логика... покинула... меня...",
            "Ты... сильнее... логики...",
            "Я... растворяюсь..."
          ],
          "onPlayerError": [
            "Моя вторая форма неуязвима для такой примитивной логики!",
            "Ошибка за ошибкой! Твои вычисления неверны!",
            "Условие не выполнено! Твоё здоровье тает!"
          ],
          "onPlayerDefeat": [
            "Истинная форма Призрака поглотила твои HP!",
            "Логика программы окончательно разрушена!",
            "Ты не прошёл проверку условий. Проигрыш!"
          ]
        }
      }
    ]
  },
  "hard": {
    "name": "Null Pointer",
    "phases": [
      {
        "phase": 1,
        "sprite": "boss-hard-1.png",
        "dialogue": {
          "start": [
            "Ты не сможешь исправить то, чего не существует!",
            "Я — пустота. Я — null. Я — конец.",
            "Твой код... он обращается в никуда!"
          ],
          "onDamage": [
            "Ты... обратился ко мне?",
            "Я... не... существую...",
            "Ты... нашёл... меня..."
          ],
          "onPhaseChange": [
            "Ты... разбудил... пустоту...",
            "Теперь... я... реален...",
            "Ты... пожалеешь..."
          ],
          "onDefeat": [
            "Я... исчезаю... в null...",
            "Пустота... поглощает... меня...",
            "Ты... победил... пустоту..."
          ],
          "onPlayerError": [
            "NullPointerExceptions! Твой вызов вернул пустоту!",
            "Ты попытался обратиться к несуществующей памяти!",
            "Ошибка указателя! Твой ответ растворился!"
          ],
          "onPlayerDefeat": [
            "Память переполнена, а твоё HP равно null!",
            "Ты канул в пустоту. Игра окончена.",
            "Фатальный сбой обращения к объекту!"
          ]
        }
      },
      {
        "phase": 2,
        "sprite": "boss-hard-2.png",
        "dialogue": {
          "start": [
            "Я... существую... чтобы... уничтожить...",
            "Твой код... обречён...",
            "Пустота... поглотит... всё..."
          ],
          "onDamage": [
            "Ты... не... можешь...",
            "Я... не... чувствую... боли...",
            "Пустота... внутри... меня..."
          ],
          "onDefeat": [
            "Я... возвращаюсь... в null...",
            "Пустота... вечна... но... ты...",
            "Ты... разорвал... цепь..."
          ],
          "onPlayerError": [
            "Вторая фаза не прощает неверных ссылок!",
            "Твой код полностью обнулился от этой ошибки!",
            "Пустота забирает твои последние силы за промах!"
          ],
          "onPlayerDefeat": [
            "Null Pointer окончательно стёр твою сессию!",
            "Твой персонаж превратился в undefined!",
            "Полная аннигиляция кода!"
          ]
        }
      }
    ]
  }
}