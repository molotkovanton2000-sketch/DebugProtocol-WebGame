{
  "easy": {
    "name": "Syntax Worm",
    "phases": [
      {
        "phase": 1,
        "sprite": "boss-easy-1.png",
        "dialogue": {
          "start": [
            "Ты не сможешь найти все мои ошибки!",
            "Этот код обречён, как и ты!",
            "Ха! Ты даже точку с запятой не найдёшь!"
          ],
          "onDamage": [
            "Ай! Ладно, это было легко...",
            "Ты... нашёл это? Неплохо.",
            "Больнее, чем я думал..."
          ],
          "onPhaseChange": [
            "Ты злишь меня!",
            "Хватит! Теперь я серьёзно!",
            "Ты пожалеешь, что зашёл так далеко!"
          ],
          "onDefeat": [
            "Нет! Мой код... он... компилируется...",
            "Ладно... ты победил... в этот раз...",
            "Я... вернусь... с новыми ошибками..."
          ]
        }
      },
      {
        "phase": 2,
        "sprite": "boss-easy-2.png",
        "dialogue": {
          "start": [
            "Теперь я серьёзно!",
            "Ты не пройдёшь дальше!",
            "Моя вторая форма... узри!"
          ],
          "onDamage": [
            "Больнее, чем я думал...",
            "Ты сильнее, чем кажешься...",
            "Это... не может быть..."
          ],
          "onDefeat": [
            "Ладно, ты победил...",
            "Мой код... он идеален... как же так...",
            "Я... ещё... вернусь..."
          ]
        }
      }
    ]
  },
  "medium": {
    "name": "Logic Wraith",
    "phases": [
      {
        "phase": 1,
        "sprite": "boss-medium-1.png",
        "dialogue": {
          "start": [
            "Твоя логика ничего не стоит против моей!",
            "Я искажаю саму суть кода!",
            "Ты не найдёшь ошибку в моей логике!"
          ],
          "onDamage": [
            "Как ты... это заметил?",
            "Моя логика... безупречна...",
            "Ты умнее, чем я думал..."
          ],
          "onPhaseChange": [
            "Ты разрушил мою логику!",
            "Теперь я покажу истинную силу!",
            "Ты пожалеешь об этом!"
          ],
          "onDefeat": [
            "Моя логика... рушится...",
            "Ты... победил... меня...",
            "Я... исчезаю... во тьме..."
          ]
        }
      },
      {
        "phase": 2,
        "sprite": "boss-medium-2.png",
        "dialogue": {
          "start": [
            "Теперь моя логика идеальна!",
            "Ты не сможешь меня победить!",
            "Узри мою истинную форму!"
          ],
          "onDamage": [
            "Невозможно... моя логика...",
            "Ты... снова... нашёл...",
            "Это... не... логично..."
          ],
          "onDefeat": [
            "Логика... покинула... меня...",
            "Ты... сильнее... логики...",
            "Я... растворяюсь..."
          ]
        }
      }
    ]
  },
  "hard": {
    "name": "Null Pointer",
    "phases": [
      {
        "phase": 1,
        "sprite": "boss-hard-1.png",
        "dialogue": {
          "start": [
            "Ты не сможешь исправить то, чего не существует!",
            "Я — пустота. Я — null. Я — конец.",
            "Твой код... он обращается в никуда!"
          ],
          "onDamage": [
            "Ты... обратился ко мне?",
            "Я... не... существую...",
            "Ты... нашёл... меня..."
          ],
          "onPhaseChange": [
            "Ты... разбудил... пустоту...",
            "Теперь... я... реален...",
            "Ты... пожалеешь..."
          ],
          "onDefeat": [
            "Я... исчезаю... в null...",
            "Пустота... поглощает... меня...",
            "Ты... победил... пустоту..."
          ]
        }
      },
      {
        "phase": 2,
        "sprite": "boss-hard-2.png",
        "dialogue": {
          "start": [
            "Я... существую... чтобы... уничтожить...",
            "Твой код... обречён...",
            "Пустота... поглотит... всё..."
          ],
          "onDamage": [
            "Ты... не... можешь...",
            "Я... не... чувствую... боли...",
            "Пустота... внутри... меня..."
          ],
          "onDefeat": [
            "Я... возвращаюсь... в null...",
            "Пустота... вечна... но... ты...",
            "Ты... разорвал... цепь..."
          ]
        }
      }
    ]
  }
}